# Copy to .env on the laptop; real values stay out of Git and deployment archives.
# Use single quotes around values containing $ or #.
TWITTER_AUTH_TOKEN=
QQ_ENABLED=false
QQ_API_BASE_URL=http://host.docker.internal:3000
QQ_TEST_GROUP_ID=
QQ_ACCESS_TOKEN=
RSSHUB_WS_ROUTE=/twitter/user/wstcg
RSSHUB_NOTIFICATION_BATCH_LIMIT=3
RSSHUB_POLLING_ENABLED=false
RSSHUB_POLLING_INTERVAL=PT5M
# Optional: replace the pinned RSSHub image deliberately when upgrading.
RSSHUB_IMAGE=
